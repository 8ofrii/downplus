# ══════════════════════════════════════════════════
# Down Plus — Environment Variables
# Copy to .env and fill in real values
# ══════════════════════════════════════════════════

# ── App ──
APP_PORT=3000
APP_ENV=development
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# ── Database ──
DATABASE_URL=postgresql://downplus:downplus_dev_2026@localhost:5432/downplus?schema=public

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── JWT ──
JWT_ACCESS_SECRET=change-me-access-secret-dev-only
JWT_REFRESH_SECRET=change-me-refresh-secret-dev-only
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── AWS / S3 (use MinIO locally) ──
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
S3_ENDPOINT=http://localhost:9000
S3_MEDICAL_DOCS_BUCKET=downplus-medical-docs-dev
S3_EXPORTS_BUCKET=downplus-exports-dev

# ── OpenRouter (LLM Gateway) ──
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=google/gemini-2.0-flash
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# ── Google Cloud Vision (OCR) ──
GCV_API_KEY=your-google-cloud-vision-key

# ── Paymob ──
PAYMOB_API_KEY=your-paymob-api-key
PAYMOB_HMAC_SECRET=your-paymob-hmac-secret
PAYMOB_INTEGRATION_ID_CARD=your-card-integration-id
PAYMOB_INTEGRATION_ID_WALLET=your-wallet-integration-id

# ── SMS (Twilio) ──
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# ── Firebase (Push Notifications) ──
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_PRIVATE_KEY=your-firebase-key

# ── Encryption ──
ENCRYPTION_KEY=change-me-32-byte-encryption-key!
