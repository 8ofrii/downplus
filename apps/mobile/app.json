{
  "expo": {
    "name": "Down Plus",
    "slug": "down-plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F1FCF5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "health.downplus.app"
    },
    "android": {
      "package": "health.downplus.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "scheme": "downplus"
  }
}
