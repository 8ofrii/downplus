{
  "expo": {
    "name": "Down Plus",
    "slug": "down-plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2A7BE4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "health.downplus.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2A7BE4"
      },
      "package": "health.downplus.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "scheme": "downplus"
  }
}
